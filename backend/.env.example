# ==============================================================================
# ICEGUARD AI - Live Polar Data Feeds Configuration (.env)
# ==============================================================================

# 1. Copernicus Marine Service (CMEMS) - Ocean Currents & SST (Optional / Free Registration)
# Register at: https://marine.copernicus.eu
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# 2. ECMWF Climate Data Store (CDS) - ERA5 10m Winds & Atmospheric Forcing (Optional / Free Registration)
# Register at: https://cds.climate.copernicus.eu
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=

# 3. Copernicus Data Space Ecosystem (CDSE) - Sentinel-1 SAR Radar Imagery (Optional / Free Registration)
# Register at: https://dataspace.copernicus.eu
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 4. Live Fetch Settings
ENABLE_LIVE_INGESTION=true
LIVE_FETCH_TIMEOUT_SECONDS=10
